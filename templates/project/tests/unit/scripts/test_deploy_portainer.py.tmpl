    arquivo = f"x-api: &api\n  image: '{API}:${{IMAGE_TAG:?defina IMAGE_TAG}}'\n"

    assert imagens_sem_tag(arquivo) == []


def test_guard_reports_image_pinned_to_a_fixed_tag() -> None:
