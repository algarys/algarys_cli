def test_guard_accepts_both_images_interpolating_image_tag() -> None:
    arquivo = (
        f"x-api: &api\n  image: {API}:${{IMAGE_TAG:?defina IMAGE_TAG}}\n"
        f"services:\n  frontend:\n    image: '{FRONT}:${{IMAGE_TAG}}'\n"
