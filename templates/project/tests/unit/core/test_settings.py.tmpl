from pathlib import Path

import pytest

from app.core.settings import Settings

RAIZ = Path(__file__).resolve().parents[3]


def test_git_sha_defaults_to_dev(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.delenv("GIT_SHA", raising=False)

    assert Settings(_env_file=None).git_sha == "dev"


def test_git_sha_comes_from_env(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setenv("GIT_SHA", "abc1234")

    assert Settings(_env_file=None).git_sha == "abc1234"


def test_stack_env_example_is_loadable() -> None:
    settings = Settings(_env_file=RAIZ / "stack.env.example")

    assert settings.cors_origins == "https://exemplo.algarys.com.br"
    assert settings.log_level == "INFO"
