def test_main_deploys_tag_from_environment_and_confirms_it_is_live(
    servidor: FakeServidor, monkeypatch: pytest.MonkeyPatch
) -> None:
<%- if .TemFrontend %>
    arquivo = "image: a-api:${IMAGE_TAG}\nimage: a-frontend:${IMAGE_TAG}\n"
<%- else %>
    arquivo = "image: a-api:${IMAGE_TAG}\n"
<%- end %>
    env = [{"name": "IMAGE_TAG", "value": "sha-aaaaaaa"}]
    servidor.responder("GET", "/api/stacks/7", {"Env": env})
    servidor.responder("GET", "/api/stacks/7/file", {"StackFileContent": arquivo})
    servidor.responder("PUT", "/api/stacks/7?endpointId=3", {"Id": 7})
    _no_ar(servidor)
    for nome, valor in {
        "PORTAINER_URL": servidor.url,
        "PORTAINER_STACK_ID": "7",
        "PORTAINER_ENDPOINT_ID": "3",
        "PORTAINER_ACCESS_TOKEN": "segredo",
        "APP_URL": servidor.url,
        "IMAGE_TAG": "sha-bbbbbbb",
    }.items():
        monkeypatch.setenv(nome, valor)

    assert main() == 0
    assert servidor.pedidos[2].corpo["env"] == [
        {"name": "IMAGE_TAG", "value": "sha-bbbbbbb"}
    ]


def test_main_fails_listing_missing_variables_before_any_request(
    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    monkeypatch.setenv("PORTAINER_URL", "http://portainer")
    for nome in ("PORTAINER_STACK_ID", "PORTAINER_ENDPOINT_ID", "APP_URL"):
        monkeypatch.setenv(nome, "x")
    monkeypatch.delenv("PORTAINER_ACCESS_TOKEN", raising=False)
    monkeypatch.setenv("IMAGE_TAG", "")

    assert main() == 1
    assert "PORTAINER_ACCESS_TOKEN, IMAGE_TAG" in capsys.readouterr().out


def test_main_fails_with_annotation_when_deploy_fails(
    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
) -> None:
    for nome in ("PORTAINER_STACK_ID", "PORTAINER_ENDPOINT_ID", "APP_URL"):
        monkeypatch.setenv(nome, "x")
    monkeypatch.setenv("PORTAINER_URL", _porta_fechada())
    monkeypatch.setenv("PORTAINER_ACCESS_TOKEN", "segredo")
    monkeypatch.setenv("IMAGE_TAG", "sha-bbbbbbb")

    assert main() == 1
    assert capsys.readouterr().out.startswith(
        "::error::Portainer inacessível em GET /api/stacks/x"
    )
